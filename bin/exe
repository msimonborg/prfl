#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "prfl"
require "prfl/cli"
require "json"

require_relative "../config"

opts = Prfl::CLI::Options.new
opts.parse!

cli = Prfl::CLI.new(opts)

# We attempt to fetch profile data for a list of batch numbers as the args
# e.g. `$ prfl -l 7825,7828,7834`
if opts.list
  list = cli.list
  list.filter_old_batch_nums

  unless list.batch_nums.empty?
    list.new_boost_session

    list.log "Checking last 20 roasts for batch numbers #{list.batch_nums.join(", ")}"

    list.get_profile_metadata
    list.extract_profiles

    if list.profiles.length < list.batch_nums.length
      list.log "Not all data was found in last 20 roasts"
      list.log "Checking all #{list.total_roast_count} roasts"
      list.search_all_profiles
    end

    list.filter_profiles_and_new_batch_nums

    # `batch_nums` now excludes those that were found on Boost (`new_batch_nums`)
    # or in the file system (`old_batch_nums`)
    list.log "Data for batch(es) #{list.batch_nums.join(", ")} not found on Boost" if list.batch_nums.length.positive?

    # `profiles` now only includes those that were not found in the file system
    # The rest can be found in `existing_profiles`
    if list.profiles.length.positive?
      list.log "Found profile data for batch(es) #{list.new_batch_nums.join(", ")} on Boost"

      list.build_fetch_list
      list.fetch_profile_data
    end

    list.driver.quit
  end
end
# if opts.list

if opts.all
  all = cli.all
  all.new_boost_session
  all.get_profile_metadata
  all.set_count

  all.log "#{all.new_count} total roast(s) on Boost since last update"

  # Exit fast if the new roast count is 0
  if all.new_count.positive?
    # Only make a second request if the first response doesn't contain the
    # full count
    all.get_profile_metadata(count: all.new_count) if all.new_count > 20

    all.extract_profiles

    all.log "Found metadata for #{all.profiles.length} new roast(s)"

    all.filter_profiles

    all.log "Identified #{all.profiles.length} new roast(s) as belonging to Carrier"

    all.profiles.each { |profile| all.add_filename(profile) }

    all.build_fetch_list

    all.fetch_profile_data
    all.update_counter
  end
  # if all.new_count.positive?

  all.driver.quit
end
# if opts.all

unless opts.no_merge
  merge = cli.merge
  merge.lookup_history
  merge.build_queue

  merge.log "Found #{merge.queue.length} unmerged file pair(s)"

  merge.merge_queue!
end

cli.log "Done. Exiting..."
