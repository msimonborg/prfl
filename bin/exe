#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "profile_merge"
require "json"

require_relative "../config"

CONFIG = ProfileMerge.config
HISTORY = "history.txt"

ARTISAN_DIR = Dir.new(CONFIG.artisan_path)
BOOST_DIR = Dir.new(CONFIG.boost_path)
TARGET_DIR = Dir.new(CONFIG.target_path)

arg = ARGV[0]

# We attempt to fetch profile data for a specific batch # when passed as an arg
# e.g. `bin/exe 7825`
if arg && arg.match?(/\d{4,}/)
  boost_data_filename = "#{arg}.json"
  path = "#{CONFIG.boost_path}/#{boost_data_filename}"

  if BOOST_DIR.children.include?(boost_data_filename)
    puts "Boost profile data for batch ##{arg} already exists at #{path}"
  else
    driver = ProfileMerge::BoostDriver.new

    response =
      begin
        driver.get_profile_metadata
      rescue ProfileMerge::BoostDriver::CookieError
        puts "No response from boost server, refreshing cookie"
        driver.new_session
        driver.get_profile_metadata
      end

    profile_metadata = JSON.parse(response)
    total_roast_count = profile_metadata["totalRstCnt"]

    profile =
      profile_metadata["profiles"].find do |elem|
        # only match if the name starts with the batch num followed by white space
        elem["prflName"].match?(/^#{arg}\b/)
      end

    profile ||= puts <<~LOG
      Profile data not found in last 20 roasts
      Checking all #{total_roast_count} roasts
    LOG

    res = driver.get_profile_metadata(count: total_roast_count)
    profile_metadata = JSON.parse(res)

    profile_metadata["profiles"].find do |elem|
      elem["prflName"].match?(/^#{arg}\b/)
    end

    if profile
      puts "Found profile data for batch ##{arg}"
      profile_data = driver.get_profile_data(profile["prflMCd"])

      path = "#{CONFIG.boost_path}/#{arg}.json"
      File.write(path, profile_data)
      puts "Downloaded boost profile data as #{path}"
    else
      puts "Profile data for batch ##{arg} not found on Boost"
    end

    driver.quit
  end
end

if arg && arg == "all"
  driver = ProfileMerge::BoostDriver.new

  response =
    begin
      driver.get_profile_metadata
    rescue ProfileMerge::BoostDriver::CookieError
      puts "No response from boost server, refreshing cookie"
      driver.new_session
      driver.get_profile_metadata
    end

  profile_metadata = JSON.parse(response)
  total_roast_count = profile_metadata["totalRstCnt"]

  response = driver.get_profile_metadata(count: total_roast_count)
  profile_metadata = JSON.parse(response)

  profile_list =
    profile_metadata["profiles"].filter do |profile|
      name = profile["prflName"]
      !name.match?(/^\d{4,}\w/) && !name.match?(/(^|\s)bi($|\s)/i)
    end

  profile_list.map! do |profile|
    id = profile["prflMCd"]
    name = profile["prflName"]
    match = name.match(/^\d{4,}\b/)

    filename =
      if match
        "#{match}_#{id}.json"
      else
        "#{id}.json"
      end

    { id: id, filename: filename }
  end

  File.write("profile_list.json", JSON.generate(profile_list))
  File.write("cookie", driver.cookie)

  IO.popen("elixir get_profile_data.exs").each { |line| puts line }

  driver.quit
end

history =
  if File.exist?(HISTORY)
    File.read(HISTORY)
  else
    ""
  end

queue =
  ARTISAN_DIR.children.collect do |artisan_file|
    # valid batch number patterns: "#1234", "#12345", "#123456" etc.
    match = artisan_file.match(/#\d{4,}/)

    next unless match

    batch_number = match.to_s.sub("#", "")
    boost_file = BOOST_DIR.children.find { |child| child.match?(batch_number) }

    next unless boost_file && !history.match(batch_number)

    {
      batch_number: batch_number,
      artisan_file: "#{CONFIG.artisan_path}/#{artisan_file}",
      boost_file: "#{CONFIG.boost_path}/#{boost_file}",
      target_path: "#{CONFIG.target_path}/#{artisan_file}"
    }
  end

# Reject nil values
queue.reject! { |elem| !elem }

puts "Found #{queue.length} unmerged file pair(s)"

queue.each do |profile|
  batch_number = profile[:batch_number]
  artisan_file = profile[:artisan_file]
  boost_file = profile[:boost_file]
  target_path = profile[:target_path]
  calibrate = batch_number.to_i <= 7775

  ProfileMerge.execute(artisan_file, boost_file, target_path, calibrate)

  File.open(HISTORY, "a") do |file|
    file.write("#{batch_number} - #{target_path}\n")
  end

  puts "Merged batch ##{batch_number}"
end
