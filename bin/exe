#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "profile_merge"
require "json"

require_relative "../config"

CONFIG = ProfileMerge.config
HISTORY = "history.txt"

ARTISAN_DIR = Dir.new(CONFIG.artisan_path)
BOOST_DIR = Dir.new(CONFIG.boost_path)
TARGET_DIR = Dir.new(CONFIG.target_path)

LOGGER = ProfileMerge::Logger

# Helpers
def extract_batch_number(profile)
  profile["prflName"].match(/^\d{4,}\b/).to_s
end

def get_profile_data(profile_list, cookie)
  File.write("profile_list.json", JSON.generate(profile_list))
  File.write("cookie", cookie)

  IO.popen("bin/get_profile_data").each { |line| LOGGER.log line }
end

# We attempt to fetch profile data for a list of batch numbers as the args
# e.g. `$ profile_merge 7825 7828 7834`
if !ARGV.empty? && ARGV.all? { |arg| arg.match?(/\d{4,}/) }
  batch_numbers =
    ARGV.filter do |arg|
      matching_file =
        BOOST_DIR.children.find do |filename|
          filename.match?("_#{arg}.json")
        end
      if matching_file
        LOGGER.log(
          "Boost profile data for batch ##{arg} already exists at #{CONFIG.boost_path}/#{matching_file}"
        )
      else
        arg
      end
    end

  if batch_numbers.length.positive?
    driver = ProfileMerge::BoostDriver.new
    driver.new_session

    LOGGER.log(
      "Checking last 20 roasts for batch numbers #{batch_numbers.join(", ")}"
    )

    response = driver.get_profile_metadata
    profile_metadata = JSON.parse(response)
    total_roast_count = profile_metadata["totalRstCnt"]

    profiles =
      profile_metadata["profiles"].filter do |profile|
        # only match if the name starts with the batch num followed by white space
        batch_number = extract_batch_number(profile)
        batch_numbers.include?(batch_number)
      end

    if profiles.length < batch_numbers.length
      LOGGER.log("Not all data was found in last 20 roasts")
      LOGGER.log("Checking all #{total_roast_count} roasts")

      response = driver.get_profile_metadata(count: total_roast_count)
      profile_metadata = JSON.parse(response)

      extra_profiles =
        profile_metadata["profiles"].filter do |profile|
          # only match if the name starts with the batch num followed by white space
          batch_number = extract_batch_number(profile)
          batch_numbers.include?(batch_number) && profiles.none?(profile)
        end

      profiles.push(*extra_profiles)
    end

    profiles =
      profiles.reduce([]) do |arr, profile|
        profile["batch_number"] = extract_batch_number(profile)
        profile["filename"]     = "#{profile["prflMCd"]}_#{profile["batch_number"]}.json"
        path                    = "#{CONFIG.boost_path}/#{profile["filename"]}"

        # The profile may already be in the file system without the batch
        # number as part of the name. We will store what the values of that
        # file would be if it exists
        existing_filename       = "#{profile["prflMCd"]}.json"
        existing_path           = "#{CONFIG.boost_path}/#{existing_filename}"

        # While we iterate through the map we remove the batch number from the original
        # args. The remaining batch numbers (args) could not be found on boost
        # or in the file system
        batch_numbers.reject! { |num| num == profile["batch_number"] }

        if File.exist?(existing_path)
          LOGGER.log(
            "Matched #{profile["batch_number"]} to existing file #{existing_filename}"
          )

          LOGGER.log(
            "Renaming existing file to #{profile["filename"]}"
          )

          # Fix the filename and filter out the profile
          File.rename(existing_path, path)
          arr
        else
          # Include the profile
          arr << profile
        end
      end

    # The variable `batch_numbers` now excludes those that were found
    # on Boost or in the file system
    if batch_numbers.length.positive?
      LOGGER.log(
        "Data for batch(es) #{batch_numbers.join(", ")} not found on Boost"
      )

    end
    # The variable `profiles` now only includes those that were not
    # found in the file system
    if profiles.length.positive?
      batch_numbers = profiles.map { |p| p["batch_number"] }

      LOGGER.log(
        "Found profile data for batch(es) #{batch_numbers.join(", ")} on Boost"
      )

      profile_list =
        profiles.map do |profile|
          { id: profile["prflMCd"], filename: profile["filename"] }
        end

      get_profile_data(profile_list, driver.cookie)
    end

    driver.quit
  end
end

if ARGV[0] && ARGV[0] == "all"
  driver = ProfileMerge::BoostDriver.new
  driver.new_session

  response = driver.get_profile_metadata
  profile_metadata = JSON.parse(response)

  counter = File.read("counter").to_i
  total_roast_count = profile_metadata["totalRstCnt"]
  count = total_roast_count - counter

  LOGGER.log(
    "#{count} total roast(s) on Boost since last update"
  )

  # Exit fast if the new roast count is 0
  if count.positive?
    # Only make a second request if the first response doesn't contain the
    # full count
    response = driver.get_profile_metadata(count: count) if count > 20

    # The response should be sorted by most recent datetime, but we will
    # do it anyway just in case, and take only the first `count` profiles
    new_profiles =
      JSON.parse(response)["profiles"].sort do |a, b|
        b["rstDt"] <=> a["rstDt"]
      end.take(count)

    LOGGER.log(
      "Found metadata for #{new_profiles.length} new roast(s)"
    )

    # Exlude profiles that match Onyx Tonics' naming conventions
    profile_list =
      new_profiles.filter do |profile|
        name = profile["prflName"]
        !name.match?(/^\d{4,}\w/) && !name.match?(/(^|\s)bi($|\s)/i)
      end

    LOGGER.log(
      "Identified #{profile_list.length} new roast(s) as belonging to Carrier"
    )

    profile_list.map! do |profile|
      id = profile["prflMCd"]
      name = profile["prflName"]
      batch_number = name.match(/^\d{4,}\b/)

      filename =
        if batch_number
          "#{id}_#{batch_number}.json"
        else
          "#{id}.json"
        end

      { id: id, filename: filename }
    end

    get_profile_data(profile_list, driver.cookie)
    File.write("counter", total_roast_count)
  end
  # if count.positive?

  driver.quit
end
# if arg && arg == "all"

history =
  if File.exist?(HISTORY)
    File.read(HISTORY)
  else
    ""
  end

queue =
  ARTISAN_DIR.children.collect do |artisan_file|
    # valid batch number patterns: "#1234", "#12345", "#123456" etc.
    match = artisan_file.match(/#\d{4,}/)

    next unless match

    batch_number = match.to_s.sub("#", "")

    boost_file =
      BOOST_DIR.children.find do |child|
        child.match?("_#{batch_number}.json")
      end

    next unless boost_file && !history.match(batch_number)

    {
      batch_number: batch_number,
      artisan_file: "#{CONFIG.artisan_path}/#{artisan_file}",
      boost_file: "#{CONFIG.boost_path}/#{boost_file}",
      target_path: "#{CONFIG.target_path}/#{artisan_file}"
    }
  end

# Select only truthy values
queue.select! { |elem| elem }

LOGGER.log(
  "Found #{queue.length} unmerged file pair(s)"
)

queue.each do |profile|
  batch_number = profile[:batch_number]
  artisan_file = profile[:artisan_file]
  boost_file = profile[:boost_file]
  target_path = profile[:target_path]
  options = {
    calibrate: batch_number.to_i <= 7775
  }

  artisan_data = ProfileMerge::ArtisanData.new(artisan_file, options)
  boost_data = ProfileMerge::BoostData.new(boost_file)
  artisan_data.merge_boost!(boost_data)
  File.write(target_path, artisan_data.convert_to_raw)

  File.open(HISTORY, "a") do |file|
    file.write("#{batch_number} - #{target_path}\n")
  end

  LOGGER.log("Merged batch ##{batch_number}")
end

LOGGER.log("Done. Exiting...")
